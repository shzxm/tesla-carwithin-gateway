<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CarWithin Gateway"
            android:textColor="#F9FAFB"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Root 安卓本地零延迟网关 · 100.64.0.1 劫持 + 正规 HTTPS/WS 反代"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#111827"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="状态：已停止"
                android:textColor="#F59E0B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTeslaUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="特斯拉车机地址：请填写域名"
                android:textColor="#60A5FA"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvUpstream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="当前上游 (主 iPhone)：未探测"
                android:textColor="#D1D5DB"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启动网关" />

                <Button
                    android:id="@+id/btnCopyUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="复制地址" />
            </LinearLayout>
        </LinearLayout>

        <!-- Basic Config -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="核心配置"
            android:textColor="#E5E7EB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDomain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1F2937"
            android:hint="域名 (如 car.yourdomain.com，A 记录指向 100.64.0.1)"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#F9FAFB"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etHijackIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1F2937"
                android:hint="劫持 IP (默认 100.64.0.1)"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#F9FAFB"
                android:textColorHint="#6B7280"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etListenPort"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#1F2937"
                android:hint="端口 8443"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#F9FAFB"
                android:textColorHint="#6B7280"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- TLS Mode -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="HTTPS 证书模式 (特斯拉要求可信绿锁)"
            android:textColor="#E5E7EB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTlsMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCloudflare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Cloudflare DNS-01 自动申请"
                android:textColor="#E5E7EB" />

            <RadioButton
                android:id="@+id/rbManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="手动导入证书"
                android:textColor="#E5E7EB" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/layoutCloudflare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etCfToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1F2937"
                android:hint="Cloudflare API Token (Zone:DNS:Edit)"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#F9FAFB"
                android:textColorHint="#6B7280"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etAcmeEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1F2937"
                android:hint="Let's Encrypt 邮箱 (可选)"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="#F9FAFB"
                android:textColorHint="#6B7280"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutManualCert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnImportCert"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="导入 fullchain.pem" />

                <Button
                    android:id="@+id/btnImportKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="导入 privkey.pem" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCertStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="证书状态：未导入"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Upstream Discovery -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="主 iPhone (CarWithin) 发现策略"
            android:textColor="#E5E7EB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTargetPort"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="#1F2937"
                android:hint="端口 9888"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#F9FAFB"
                android:textColorHint="#6B7280"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etTargetMac"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#1F2937"
                android:hint="可选：主 iPhone MAC 锁定"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#F9FAFB"
                android:textColorHint="#6B7280"
                android:textSize="14sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etManualUpstream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1F2937"
            android:hint="可选：手动固定上游 IP (留空则自动通过 ip neigh 扫描 9888)"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#F9FAFB"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <!-- Live Logs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="运行日志"
                android:textColor="#E5E7EB"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClearLogs"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="清空"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="#050811"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:text="等待启动...\n"
            android:textColor="#10B981"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
